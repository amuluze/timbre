{
  "ax": "1.6",
  "name": "timbre-x",
  "tokens": {
    "color-ink": {
      "$type": "color",
      "$value": {
        "light": "#14181A",
        "dark": "#E9ECEA"
      }
    },
    "color-ink-mute": {
      "$type": "color",
      "$value": {
        "light": "#5C6663",
        "dark": "#98A29E"
      }
    },
    "color-ink-faint": {
      "$type": "color",
      "$value": {
        "light": "#8B9390",
        "dark": "#6E7874"
      }
    },
    "color-paper": {
      "$type": "color",
      "$value": {
        "light": "#F5F6F3",
        "dark": "#101413"
      }
    },
    "color-surface": {
      "$type": "color",
      "$value": {
        "light": "#FFFFFF",
        "dark": "#191E1D"
      }
    },
    "color-line": {
      "$type": "color",
      "$value": {
        "light": "#D6DAD6",
        "dark": "#2A312F"
      }
    },
    "color-fundamental": {
      "$type": "color",
      "$value": {
        "light": "#0E5C54",
        "dark": "#35B7A4"
      }
    },
    "color-fundamental-soft": {
      "$type": "color",
      "$value": {
        "light": "#E3EFEC",
        "dark": "#12312D"
      }
    },
    "color-attention": {
      "$type": "color",
      "$value": {
        "light": "#8A5A12",
        "dark": "#D6A54A"
      }
    },
    "pitch-x": {
      "$type": "color",
      "$value": {
        "light": "#4A524F",
        "dark": "#B9C1BD"
      }
    },
    "space-1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "space-2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "space-3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "space-4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "space-5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "space-6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "radius-1": {
      "$type": "dimension",
      "$value": "6px"
    },
    "radius-2": {
      "$type": "dimension",
      "$value": "10px"
    },
    "radius-pill": {
      "$type": "dimension",
      "$value": "999px"
    },
    "text-display": {
      "$type": "dimension",
      "$value": "34px"
    },
    "text-section": {
      "$type": "dimension",
      "$value": "20px"
    },
    "text-manuscript": {
      "$type": "dimension",
      "$value": "17px"
    },
    "text-ui": {
      "$type": "dimension",
      "$value": "15px"
    },
    "text-caption": {
      "$type": "dimension",
      "$value": "13px"
    },
    "text-micro": {
      "$type": "dimension",
      "$value": "12px"
    },
    "font-ui": {
      "$type": "fontFamily",
      "$value": "Inter, -apple-system, 'PingFang SC', system-ui, sans-serif"
    },
    "font-manuscript": {
      "$type": "fontFamily",
      "$value": "'Songti SC', 'Noto Serif SC', Georgia, serif"
    }
  },
  "components": {},
  "symbols": {
    "NavItem": {
      "props": {
        "label": "string",
        "icon": {
          "enum": [
            "layout-dashboard",
            "columns-3",
            "circle-check",
            "send",
            "audio-lines",
            "settings"
          ]
        }
      },
      "body": [
        {
          "id": "nvi-row",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "nvi-icon",
              "kind": "icon",
              "name": {
                "$param": "icon"
              },
              "size": 15,
              "fill": "$color-ink-mute"
            },
            {
              "id": "nvi-label",
              "kind": "text",
              "text": {
                "$param": "label"
              },
              "fontSize": "$text-caption",
              "fontWeight": 500,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink",
              "width": "fill_container",
              "height": "fit_content"
            }
          ],
          "gap": "$space-2",
          "padding": [
            0,
            "$space-3",
            0,
            "$space-3"
          ],
          "height": 34,
          "alignItems": "center",
          "cornerRadius": "$radius-1"
        }
      ]
    },
    "NavItemActive": {
      "props": {
        "label": "string",
        "icon": {
          "enum": [
            "layout-dashboard",
            "columns-3",
            "circle-check",
            "send",
            "audio-lines",
            "settings"
          ]
        }
      },
      "body": [
        {
          "id": "nva-row",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "nva-bar",
              "kind": "rect",
              "width": 2,
              "height": 16,
              "fill": "$color-fundamental"
            },
            {
              "id": "nva-icon",
              "kind": "icon",
              "name": {
                "$param": "icon"
              },
              "size": 15,
              "fill": "$color-fundamental"
            },
            {
              "id": "nva-label",
              "kind": "text",
              "text": {
                "$param": "label"
              },
              "fontSize": "$text-caption",
              "fontWeight": 500,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-fundamental",
              "width": "fill_container",
              "height": "fit_content"
            }
          ],
          "gap": "$space-2",
          "padding": [
            0,
            "$space-3",
            0,
            "$space-3"
          ],
          "height": 34,
          "fill": "$color-fundamental-soft",
          "alignItems": "center",
          "cornerRadius": "$radius-1"
        }
      ]
    },
    "KpiCell": {
      "props": {
        "label": "string",
        "value": "string",
        "delta": "string"
      },
      "body": [
        {
          "id": "kpi-col",
          "kind": "frame",
          "layout": "vertical",
          "children": [
            {
              "id": "kpi-label",
              "kind": "text",
              "text": {
                "$param": "label"
              },
              "fontSize": "$text-caption",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink-mute",
              "width": "fill_container",
              "height": "fit_content"
            },
            {
              "id": "kpi-value",
              "kind": "text",
              "text": {
                "$param": "value"
              },
              "fontSize": "$text-section",
              "fontWeight": 600,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.2
              },
              "wrap": "width",
              "fill": "$color-ink",
              "width": "fit_content",
              "height": "fit_content"
            },
            {
              "id": "kpi-delta",
              "kind": "text",
              "text": {
                "$param": "delta"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink-mute",
              "width": "fill_container",
              "height": "fit_content"
            }
          ],
          "gap": "$space-1"
        }
      ]
    },
    "FilterChip": {
      "props": {
        "label": "string"
      },
      "body": [
        {
          "id": "fc-box",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "fc-label",
              "kind": "text",
              "text": {
                "$param": "label"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.3
              },
              "wrap": "width",
              "fill": "$color-ink-mute",
              "width": "fit_content",
              "height": "fit_content"
            }
          ],
          "padding": [
            "$space-1",
            "$space-3",
            "$space-1",
            "$space-3"
          ],
          "width": "fit_content",
          "height": 26,
          "alignItems": "center",
          "cornerRadius": "$radius-pill",
          "stroke": "$color-line",
          "strokeWidth": 1
        }
      ]
    },
    "StateChip": {
      "props": {
        "label": "string"
      },
      "body": [
        {
          "id": "sc-box",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "sc-label",
              "kind": "text",
              "text": {
                "$param": "label"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.3
              },
              "wrap": "width",
              "fill": "$color-ink-mute",
              "width": "fit_content",
              "height": "fit_content"
            }
          ],
          "padding": [
            2,
            "$space-2",
            2,
            "$space-2"
          ],
          "width": "fit_content",
          "alignItems": "center",
          "cornerRadius": "$radius-pill",
          "stroke": "$color-line",
          "strokeWidth": 1
        }
      ]
    },
    "ListRow": {
      "props": {
        "col1": "string",
        "col2": "string",
        "col3": "string",
        "col4": "string"
      },
      "body": [
        {
          "id": "lr-row",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "lr-c1",
              "kind": "text",
              "text": {
                "$param": "col1"
              },
              "fontSize": "$text-caption",
              "fontWeight": 500,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink",
              "width": "fill_container",
              "height": "fit_content"
            },
            {
              "id": "lr-c2",
              "kind": "text",
              "text": {
                "$param": "col2"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink-mute",
              "width": 72,
              "height": "fit_content"
            },
            {
              "id": "lr-c3",
              "kind": "text",
              "text": {
                "$param": "col3"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink-mute",
              "width": 84,
              "height": "fit_content"
            },
            {
              "id": "lr-c4",
              "kind": "text",
              "text": {
                "$param": "col4"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink-faint",
              "width": 96,
              "height": "fit_content",
              "textAlign": "right"
            }
          ],
          "gap": "$space-3",
          "height": 38,
          "alignItems": "center"
        }
      ]
    },
    "ThreadRow": {
      "props": {
        "num": "string",
        "text": "string",
        "source": "string"
      },
      "body": [
        {
          "id": "tr-row",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "tr-num",
              "kind": "text",
              "text": {
                "$param": "num"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink-faint",
              "width": 32,
              "height": "fit_content"
            },
            {
              "id": "tr-text",
              "kind": "text",
              "text": {
                "$param": "text"
              },
              "fontSize": "$text-caption",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.6
              },
              "wrap": "width",
              "fill": "$color-ink",
              "width": "fill_container",
              "height": "fit_content"
            },
            {
              "id": "tr-src",
              "kind": "text",
              "text": {
                "$param": "source"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.3
              },
              "wrap": "width",
              "fill": "$color-ink-faint",
              "width": 88,
              "height": "fit_content"
            }
          ],
          "gap": "$space-3",
          "width": "fill_container",
          "height": "fit_content",
          "alignItems": "start"
        }
      ]
    },
    "TimelineRow": {
      "props": {
        "time": "string",
        "label": "string",
        "note": "string"
      },
      "body": [
        {
          "id": "tl-row",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "tl-dot",
              "kind": "rect",
              "width": 7,
              "height": 7,
              "fill": "$color-fundamental"
            },
            {
              "id": "tl-body",
              "kind": "frame",
              "layout": "vertical",
              "children": [
                {
                  "id": "tl-label",
                  "kind": "text",
                  "text": {
                    "$param": "label"
                  },
                  "fontSize": "$text-caption",
                  "fontWeight": 500,
                  "fontFamily": "$font-ui",
                  "lineHeight": {
                    "unit": "multiplier",
                    "value": 1.4
                  },
                  "wrap": "width",
                  "fill": "$color-ink",
                  "width": "fill_container",
                  "height": "fit_content"
                },
                {
                  "id": "tl-note",
                  "kind": "text",
                  "text": {
                    "$param": "note"
                  },
                  "fontSize": "$text-caption",
                  "fontWeight": 400,
                  "fontFamily": "$font-ui",
                  "lineHeight": {
                    "unit": "multiplier",
                    "value": 1.5
                  },
                  "wrap": "width",
                  "fill": "$color-ink-mute",
                  "width": "fill_container",
                  "height": "fit_content"
                },
                {
                  "id": "tl-time",
                  "kind": "text",
                  "text": {
                    "$param": "time"
                  },
                  "fontSize": "$text-micro",
                  "fontWeight": 400,
                  "fontFamily": "$font-ui",
                  "lineHeight": {
                    "unit": "multiplier",
                    "value": 1.3
                  },
                  "wrap": "width",
                  "fill": "$color-ink-faint",
                  "width": "fit_content",
                  "height": "fit_content"
                }
              ],
              "gap": 2
            }
          ],
          "gap": "$space-3",
          "width": "fill_container",
          "height": "fit_content",
          "alignItems": "start"
        }
      ]
    },
    "EmptyState": {
      "props": {
        "headline": "string",
        "supporting": "string"
      },
      "body": [
        {
          "id": "es-col",
          "kind": "frame",
          "layout": "vertical",
          "children": [
            {
              "id": "es-icon",
              "kind": "icon",
              "name": "inbox",
              "size": 24,
              "fill": "$color-ink-faint"
            },
            {
              "id": "es-head",
              "kind": "text",
              "text": {
                "$param": "headline"
              },
              "fontSize": "$text-section",
              "fontWeight": 600,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink",
              "width": "fit_content",
              "height": "fit_content"
            },
            {
              "id": "es-sup",
              "kind": "text",
              "text": {
                "$param": "supporting"
              },
              "fontSize": "$text-caption",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.5
              },
              "wrap": "width",
              "fill": "$color-ink-mute",
              "width": "fill_container",
              "height": "fit_content",
              "textAlign": "center"
            }
          ],
          "gap": "$space-3",
          "alignItems": "center",
          "justifyContent": "center"
        }
      ]
    }
  },
  "pages": [
    {
      "id": "p-overview",
      "name": "概览",
      "width": 1440,
      "height": 900,
      "tree": [
        {
          "id": "ov-app",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "sb",
              "kind": "frame",
              "layout": "vertical",
              "children": [
                {
                  "id": "sb-brand",
                  "kind": "frame",
                  "layout": "vertical",
                  "children": [
                    {
                      "id": "sb-cn",
                      "kind": "text",
                      "text": "腔调",
                      "fontSize": "$text-section",
                      "fontWeight": 600,
                      "fontFamily": "$font-ui",
                      "lineHeight": {
                        "unit": "multiplier",
                        "value": 1.2
                      },
                      "wrap": "width",
                      "fill": "$color-ink",
                      "width": "fit_content",
                      "height": "fit_content"
                    },
                    {
                      "id": "sb-en",
                      "kind": "text",
                      "text": "Timbre · 只连 @yehang_kiosk",
                      "fontSize": "$text-micro",
                      "fontWeight": 400,
                      "fontFamily": "$font-ui",
                      "lineHeight": {
                        "unit": "multiplier",
                        "value": 1.4
                      },
                      "wrap": "width",
                      "fill": "$color-ink-mute",
                      "width": "fit_content",
                      "height": "fit_content"
                    }
                  ],
                  "gap": 2
                },
                {
                  "id": "sb-div",
                  "kind": "part",
                  "part": "divider"
                },
                {
                  "id": "sb-nav",
                  "kind": "frame",
                  "layout": "vertical",
                  "children": [
                    {
                      "id": "sb-n1",
                      "kind": "component",
                      "name": "NavItemActive",
                      "props": {
                        "label": "概览",
                        "icon": "layout-dashboard"
                      }
                    },
                    {
                      "id": "sb-n2",
                      "kind": "component",
                      "name": "NavItem",
                      "props": {
                        "label": "工作台",
                        "icon": "columns-3"
                      }
                    },
                    {
                      "id": "sb-n3",
                      "kind": "component",
                      "name": "NavItem",
                      "props": {
                        "label": "变体审阅",
                        "icon": "circle-check"
                      }
                    },
                    {
                      "id": "sb-n4",
                      "kind": "component",
                      "name": "NavItem",
                      "props": {
                        "label": "发布队列",
                        "icon": "send"
                      }
                    },
                    {
                      "id": "sb-n5",
                      "kind": "component",
                      "name": "NavItem",
                      "props": {
                        "label": "X 腔调",
                        "icon": "audio-lines"
                      }
                    },
                    {
                      "id": "sb-n6",
                      "kind": "component",
                      "name": "NavItem",
                      "props": {
                        "label": "设置",
                        "icon": "settings"
                      }
                    }
                  ],
                  "gap": 2
                },
                {
                  "id": "sb-sp",
                  "kind": "frame",
                  "layout": "vertical",
                  "children": [],
                  "width": "fill_container",
                  "height": "fill_container"
                },
                {
                  "id": "sb-foot",
                  "kind": "frame",
                  "layout": "vertical",
                  "children": [
                    {
                      "id": "sb-f1",
                      "kind": "text",
                      "text": "X 账号：@yehang_kiosk",
                      "fontSize": "$text-micro",
                      "fontWeight": 400,
                      "fontFamily": "$font-ui",
                      "lineHeight": {
                        "unit": "multiplier",
                        "value": 1.4
                      },
                      "wrap": "width",
                      "fill": "$color-ink-mute",
                      "width": "fit_content",
                      "height": "fit_content"
                    },
                    {
                      "id": "sb-f2",
                      "kind": "text",
                      "text": "密钥与草稿只在本机",
                      "fontSize": "$text-micro",
                      "fontWeight": 400,
                      "fontFamily": "$font-ui",
                      "lineHeight": {
                        "unit": "multiplier",
                        "value": 1.4
                      },
                      "wrap": "width",
                      "fill": "$color-ink-faint",
                      "width": "fit_content",
                      "height": "fit_content"
                    }
                  ],
                  "gap": 2
                }
              ],
              "gap": "$space-4",
              "padding": [
                "$space-4",
                "$space-3",
                "$space-4",
                "$space-3"
              ],
              "width": 232,
              "height": "fill_container",
              "fill": "$color-surface"
            },
            {
              "id": "ov-rule",
              "kind": "rect",
              "width": 1,
              "height": 900,
              "fill": "$color-line"
            },
            {
              "id": "ov-main",
              "kind": "frame",
              "layout": "vertical",
              "children": [
                {
                  "id": "ov-head",
                  "kind": "frame",
                  "layout": "horizontal",
                  "children": [
                    {
                      "id": "ov-head-t",
                      "kind": "frame",
                      "layout": "vertical",
                      "children": [
                        {
                          "id": "ov-head-title",
                          "kind": "text",
                          "text": "X 上今天只有一件事要做",
                          "fontSize": "$text-display",
                          "fontWeight": 600,
                          "fontFamily": "$font-ui",
                          "lineHeight": {
                            "unit": "multiplier",
                            "value": 1.25
                          },
                          "wrap": "width",
                          "fill": "$color-ink",
                          "width": "fit_content",
                          "height": "fit_content"
