                              "id": "ws-ms-n",
                              "kind": "text",
                              "text": "母稿",
                              "fontSize": "$text-caption",
                              "fontWeight": 500,
                              "fontFamily": "$font-ui",
                              "lineHeight": {
                                "unit": "multiplier",
                                "value": 1.3
                              },
                              "wrap": "width",
                              "fill": "$color-ink",
                              "width": "fill_container",
                              "height": "fit_content"
                            },
                            {
                              "id": "ws-ms-c",
                              "kind": "text",
                              "text": "218 字",
                              "fontSize": "$text-micro",
                              "fontWeight": 400,
                              "fontFamily": "$font-ui",
                              "lineHeight": {
                                "unit": "multiplier",
                                "value": 1.3
                              },
                              "wrap": "width",
                              "fill": "$color-ink-faint",
                              "width": "fit_content",
                              "height": "fit_content"
                            }
