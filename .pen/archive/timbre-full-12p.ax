            }
          ],
          "gap": "$space-3",
          "width": "fill_container",
          "height": 40,
          "alignItems": "center"
        }
      ]
    },
    "TimelineRow": {
      "props": {
        "time": "string",
        "label": "string",
        "note": "string"
      },
      "body": [
        {
          "id": "tl-row",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "tl-dot",
              "kind": "rect",
              "width": 7,
              "height": 7,
              "fill": "$color-fundamental"
            },
            {
              "id": "tl-body",
              "kind": "frame",
              "layout": "vertical",
