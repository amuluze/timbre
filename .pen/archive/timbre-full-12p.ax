                        {
                          "id": "ws-m-act2",
                          "kind": "text",
                          "text": "改母稿会作废变体",
                          "fontSize": "$text-micro",
                          "fontWeight": 400,
                          "fontFamily": "$font-ui",
                          "lineHeight": {
                            "unit": "multiplier",
                            "value": 1.3
                          },
                          "wrap": "width",
