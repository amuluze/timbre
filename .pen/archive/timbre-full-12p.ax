            2,
            "$space-2"
          ],
          "width": "fit_content",
          "alignItems": "center",
          "cornerRadius": "$radius-pill",
          "stroke": "$color-line",
          "strokeWidth": 1
        }
      ]
    },
    "ListRow": {
      "props": {
        "col1": "string",
        "col2": "string",
        "col3": "string",
        "col4": "string"
      },
      "body": [
        {
          "id": "lr-row",
          "kind": "frame",
          "layout": "horizontal",
