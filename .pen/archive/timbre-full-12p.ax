            },
            {
              "id": "lr-c2",
              "kind": "text",
              "text": {
                "$param": "col2"
              },
              "fontSize": "$text-caption",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink-mute",
              "width": 120,
              "height": "fit_content"
            },
            {
              "id": "lr-c3",
              "kind": "text",
              "text": {
                "$param": "col3"
              },
              "fontSize": "$text-caption",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink-mute",
              "width": 96,
              "height": "fit_content"
            },
            {
              "id": "lr-c4",
              "kind": "text",
              "text": {
                "$param": "col4"
              },
              "fontSize": "$text-caption",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink-mute",
              "width": 80,
              "height": "fit_content",
              "textAlign": "right"
            }
          ],
          "gap": "$space-3",
          "width": "fill_container",
          "height": 38,
          "alignItems": "center"
        }
      ]
    },
    "QueueRow": {
      "props": {
        "title": "string",
        "platform": "string",
        "status": "string",
        "time": "string"
      },
      "body": [
        {
          "id": "qr-row",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "qr-title",
              "kind": "text",
              "text": {
