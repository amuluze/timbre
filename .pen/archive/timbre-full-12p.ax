{
  "ax": "1.6",
  "name": "timbre",
  "tokens": {
    "color-ink": {
      "$type": "color",
      "$value": {
        "light": "#14181A",
        "dark": "#E9ECEA"
      }
    },
    "color-ink-mute": {
      "$type": "color",
      "$value": {
        "light": "#5C6663",
        "dark": "#98A29E"
      }
    },
    "color-ink-faint": {
      "$type": "color",
      "$value": {
        "light": "#8B9390",
        "dark": "#6E7874"
      }
    },
    "color-paper": {
      "$type": "color",
      "$value": {
        "light": "#F5F6F3",
        "dark": "#101413"
      }
    },
    "color-surface": {
      "$type": "color",
      "$value": {
        "light": "#FFFFFF",
        "dark": "#191E1D"
      }
    },
    "color-line": {
      "$type": "color",
      "$value": {
        "light": "#D6DAD6",
        "dark": "#2A312F"
      }
    },
    "color-fundamental": {
      "$type": "color",
      "$value": {
        "light": "#0E5C54",
        "dark": "#35B7A4"
      }
    },
    "color-fundamental-soft": {
      "$type": "color",
      "$value": {
        "light": "#E3EFEC",
        "dark": "#12312D"
      }
    },
    "color-attention": {
      "$type": "color",
      "$value": {
        "light": "#8A5A12",
        "dark": "#D6A54A"
      }
    },
    "pitch-douyin": {
      "$type": "color",
      "$value": {
        "light": "#B8391F",
        "dark": "#E4705A"
      }
    },
    "pitch-xhs": {
      "$type": "color",
      "$value": {
        "light": "#A8304F",
        "dark": "#E97A97"
      }
    },
    "pitch-bili": {
      "$type": "color",
      "$value": {
        "light": "#2F4C99",
        "dark": "#7C97E4"
      }
    },
    "pitch-x": {
      "$type": "color",
      "$value": {
        "light": "#4A524F",
        "dark": "#B9C1BD"
      }
    },
    "pitch-shipinhao": {
      "$type": "color",
      "$value": {
        "light": "#2E6B4F",
        "dark": "#67BE8E"
      }
    },
    "space-1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "space-2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "space-3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "space-4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "space-5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "space-6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "space-7": {
      "$type": "dimension",
      "$value": "48px"
    },
    "radius-1": {
      "$type": "dimension",
      "$value": "6px"
    },
    "radius-2": {
      "$type": "dimension",
      "$value": "10px"
    },
    "radius-3": {
      "$type": "dimension",
      "$value": "16px"
    },
    "radius-pill": {
      "$type": "dimension",
      "$value": "999px"
    },
    "text-display": {
      "$type": "dimension",
      "$value": "34px"
    },
    "text-title": {
      "$type": "dimension",
      "$value": "26px"
    },
    "text-section": {
      "$type": "dimension",
      "$value": "20px"
    },
    "text-manuscript": {
      "$type": "dimension",
      "$value": "17px"
    },
    "text-ui": {
      "$type": "dimension",
      "$value": "15px"
    },
    "text-caption": {
      "$type": "dimension",
      "$value": "13px"
    },
    "text-micro": {
      "$type": "dimension",
      "$value": "12px"
    },
    "font-ui": {
      "$type": "fontFamily",
      "$value": "Inter, -apple-system, 'PingFang SC', system-ui, sans-serif"
    },
    "font-manuscript": {
      "$type": "fontFamily",
      "$value": "'Songti SC', 'Noto Serif SC', Georgia, serif"
    }
  },
  "components": {},
  "symbols": {
    "NavItem": {
      "props": {
        "label": "string",
        "icon": {
          "enum": [
            "layout-dashboard",
            "pen-line",
            "columns-3",
            "circle-check",
            "send",
            "scroll-text",
            "folder",
            "audio-lines",
            "settings"
          ]
        }
      },
      "body": [
        {
          "id": "navi-row",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "navi-icon",
              "kind": "icon",
              "name": {
                "$param": "icon"
              },
              "size": 15,
              "fill": "$color-ink-mute"
            },
            {
              "id": "navi-label",
              "kind": "text",
              "text": {
                "$param": "label"
              },
              "fontSize": "$text-caption",
              "fontWeight": 500,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink",
              "width": "fill_container",
              "height": "fit_content"
            }
          ],
          "gap": "$space-2",
          "padding": [
            0,
            "$space-3",
            0,
            "$space-3"
          ],
          "height": 34,
          "alignItems": "center",
          "cornerRadius": "$radius-1"
        }
      ]
    },
    "NavItemActive": {
      "props": {
        "label": "string",
        "icon": {
          "enum": [
            "layout-dashboard",
            "pen-line",
            "columns-3",
            "circle-check",
            "send",
            "scroll-text",
            "folder",
            "audio-lines",
            "settings"
          ]
        }
      },
      "body": [
        {
          "id": "nava-row",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "nava-bar",
              "kind": "rect",
              "width": 2,
              "height": 16,
              "fill": "$color-fundamental"
            },
            {
              "id": "nava-icon",
              "kind": "icon",
              "name": {
                "$param": "icon"
              },
              "size": 15,
              "fill": "$color-fundamental"
            },
            {
              "id": "nava-label",
              "kind": "text",
              "text": {
                "$param": "label"
              },
              "fontSize": "$text-caption",
              "fontWeight": 500,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-fundamental",
              "width": "fill_container",
              "height": "fit_content"
            }
          ],
          "gap": "$space-2",
          "padding": [
            0,
            "$space-3",
            0,
            "$space-3"
          ],
          "height": 34,
          "fill": "$color-fundamental-soft",
          "alignItems": "center",
          "cornerRadius": "$radius-1"
        }
      ]
    },
    "KpiCell": {
      "props": {
        "label": "string",
        "value": "string",
        "delta": "string"
      },
      "body": [
        {
          "id": "kpi-col",
          "kind": "frame",
          "layout": "vertical",
          "children": [
            {
              "id": "kpi-label",
              "kind": "text",
              "text": {
                "$param": "label"
              },
              "fontSize": "$text-caption",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink-mute",
              "width": "fill_container",
              "height": "fit_content"
            },
            {
              "id": "kpi-value",
              "kind": "text",
              "text": {
                "$param": "value"
              },
              "fontSize": "$text-title",
              "fontWeight": 600,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.2
              },
              "wrap": "width",
              "fill": "$color-ink",
              "width": "fit_content",
              "height": "fit_content"
            },
            {
              "id": "kpi-delta",
              "kind": "text",
              "text": {
                "$param": "delta"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink-mute",
              "width": "fill_container",
              "height": "fit_content"
            }
          ],
          "gap": "$space-1",
          "width": "fill_container",
          "height": "fit_content"
        }
      ]
    },
    "FilterChip": {
      "props": {
        "label": "string"
      },
      "body": [
        {
          "id": "chip-box",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "chip-label",
              "kind": "text",
              "text": {
                "$param": "label"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.3
              },
              "wrap": "width",
              "fill": "$color-ink-mute",
              "width": "fit_content",
              "height": "fit_content"
            }
          ],
          "padding": [
            "$space-1",
            "$space-3",
            "$space-1",
            "$space-3"
          ],
          "width": "fit_content",
          "height": 26,
          "alignItems": "center",
          "cornerRadius": "$radius-pill",
          "stroke": "$color-line",
          "strokeWidth": 1
        }
      ]
    },
    "StateChip": {
      "props": {
        "label": "string"
      },
      "body": [
        {
          "id": "sc-box",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "sc-label",
              "kind": "text",
              "text": {
                "$param": "label"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
