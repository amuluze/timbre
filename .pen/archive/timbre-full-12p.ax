                      "kind": "text",
                      "text": "门从 23 点开到凌晨 2 点。",
                      "fontSize": "$text-caption",
                      "fontWeight": 400,
                      "fontFamily": "$font-ui",
                      "lineHeight": {
                        "unit": "multiplier",
                        "value": 1.6
                      },
                      "wrap": "width",
                      "fill": "$color-ink",
                      "width": "fill_container",
                      "height": "fit_content"
                    },
                    {
                      "id": "ws-dy-l4",
