            },
            {
              "id": "pr-action",
              "kind": "text",
              "text": {
                "$param": "action"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.3
              },
              "wrap": "width",
              "fill": "$color-fundamental",
              "width": 56,
              "height": "fit_content",
