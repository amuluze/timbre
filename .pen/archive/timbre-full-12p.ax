              "height": "fit_content"
            }
          ],
          "gap": "$space-3",
          "width": "fill_container",
          "height": "fit_content",
          "alignItems": "start"
        }
      ]
    },
    "AssetTile": {
      "props": {
        "name": "string",
        "meta": "string"
      },
      "body": [
        {
          "id": "at-box",
          "kind": "frame",
          "layout": "vertical",
          "children": [
            {
              "id": "at-thumb",
              "kind": "frame",
              "layout": "vertical",
              "children": [],
              "width": "fill_container",
              "height": 88,
              "fill": "$color-fundamental-soft",
              "cornerRadius": "$radius-1"
            },
            {
              "id": "at-name",
              "kind": "text",
