                    },
                    {
                      "id": "ws-dy-l6",
                      "kind": "text",
                      "text": "我们在城郊长乐路 112 号，门口那张小桌一直空着。",
                      "fontSize": "$text-caption",
                      "fontWeight": 400,
                      "fontFamily": "$font-ui",
                      "lineHeight": {
                        "unit": "multiplier",
                        "value": 1.6
                      },
                      "wrap": "width",
