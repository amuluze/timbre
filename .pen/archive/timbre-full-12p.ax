                    },
                    {
                      "id": "ws-xhs-p2",
                      "kind": "text",
                      "text": "阿哲在挑第二锅骨汤，勺子提起来，油光要刚好挂住——他说这是「等的味道」。",
                      "fontSize": "$text-caption",
                      "fontWeight": 400,
                      "fontFamily": "$font-ui",
                      "lineHeight": {
