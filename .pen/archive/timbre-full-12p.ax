                      "height": "fit_content"
                    },
                    {
                      "id": "ws-dy-l5",
                      "kind": "text",
                      "text": "今晚来吗，汤还热。",
                      "fontSize": "$text-caption",
                      "fontWeight": 500,
                      "fontFamily": "$font-ui",
                      "lineHeight": {
