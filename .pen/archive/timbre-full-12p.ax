            },
            {
              "id": "pr-platform",
              "kind": "text",
              "text": {
                "$param": "platform"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink-mute",
              "width": 60,
              "height": "fit_content"
            },
            {
              "id": "pr-status",
              "kind": "frame",
              "layout": "horizontal",
              "children": [
                {
                  "id": "pr-status-t",
                  "kind": "text",
