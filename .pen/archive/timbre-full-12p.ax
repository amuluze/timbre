              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink-faint",
              "width": 104,
              "height": "fit_content",
              "textAlign": "right"
            }
          ],
          "gap": "$space-3",
          "width": "fill_container",
          "height": 40,
          "alignItems": "center"
        }
      ]
    },
    "PublishRow": {
      "props": {
        "title": "string",
        "platform": "string",
        "status": "string",
        "when": "string",
        "account": "string",
        "action": "string"
      },
      "body": [
        {
          "id": "pr-row",
          "kind": "frame",
