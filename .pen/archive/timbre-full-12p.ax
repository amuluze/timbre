                      "height": "fit_content"
                    },
                    {
                      "id": "ws-xhs-p3",
                      "kind": "text",
                      "text": "代驾、下夜班的护士、抱着电脑改方案的设计师，都坐过门口那张小桌。",
                      "fontSize": "$text-caption",
                      "fontWeight": 400,
                      "fontFamily": "$font-ui",
                      "lineHeight": {
                        "unit": "multiplier",
                        "value": 1.9
