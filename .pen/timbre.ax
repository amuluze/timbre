{
  "ax": "1.6",
  "name": "timbre",
  "tokens": {
    "color-ink": {
      "$type": "color",
      "$value": {
        "light": "#14181A",
        "dark": "#E9ECEA"
      }
    },
    "color-ink-mute": {
      "$type": "color",
      "$value": {
        "light": "#5C6663",
        "dark": "#98A29E"
      }
    },
    "color-ink-faint": {
      "$type": "color",
      "$value": {
        "light": "#8B9390",
        "dark": "#6E7874"
      }
    },
    "color-paper": {
      "$type": "color",
      "$value": {
        "light": "#F5F6F3",
        "dark": "#101413"
      }
    },
    "color-surface": {
      "$type": "color",
      "$value": {
        "light": "#FFFFFF",
        "dark": "#191E1D"
      }
    },
    "color-line": {
      "$type": "color",
      "$value": {
        "light": "#D6DAD6",
        "dark": "#2A312F"
      }
    },
    "color-fundamental": {
      "$type": "color",
      "$value": {
        "light": "#0E5C54",
        "dark": "#35B7A4"
      }
    },
    "color-fundamental-soft": {
      "$type": "color",
      "$value": {
        "light": "#E3EFEC",
        "dark": "#12312D"
      }
    },
    "pitch-x": {
      "$type": "color",
      "$value": {
        "light": "#4A524F",
        "dark": "#B9C1BD"
      }
    },
    "space-1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "space-2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "space-3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "space-4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "space-5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "radius-1": {
      "$type": "dimension",
      "$value": "6px"
    },
    "radius-pill": {
      "$type": "dimension",
      "$value": "999px"
    },
    "text-section": {
      "$type": "dimension",
      "$value": "20px"
    },
    "text-ui": {
      "$type": "dimension",
      "$value": "15px"
    },
    "text-caption": {
      "$type": "dimension",
      "$value": "13px"
    },
    "text-micro": {
      "$type": "dimension",
      "$value": "12px"
    },
    "font-ui": {
      "$type": "fontFamily",
      "$value": "Inter, -apple-system, 'PingFang SC', system-ui, sans-serif"
    },
    "font-manuscript": {
      "$type": "fontFamily",
      "$value": "'Songti SC', 'Noto Serif SC', Georgia, serif"
    },
    "color-attention": {
      "$type": "color",
      "$value": {
        "light": "#8A5A12",
        "dark": "#D6A54A"
      }
    },
    "pitch-douyin": {
      "$type": "color",
      "$value": {
        "light": "#B8391F",
        "dark": "#E4705A"
      }
    },
    "pitch-xhs": {
      "$type": "color",
      "$value": {
        "light": "#A8304F",
        "dark": "#E97A97"
      }
    },
    "pitch-bili": {
      "$type": "color",
      "$value": {
        "light": "#2F4C99",
        "dark": "#7C97E4"
      }
    },
    "pitch-shipinhao": {
      "$type": "color",
      "$value": {
        "light": "#2E6B4F",
        "dark": "#67BE8E"
      }
    },
    "space-6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "space-7": {
      "$type": "dimension",
      "$value": "48px"
    },
    "radius-2": {
      "$type": "dimension",
      "$value": "10px"
    },
    "radius-3": {
      "$type": "dimension",
      "$value": "16px"
    },
    "text-display": {
      "$type": "dimension",
      "$value": "34px"
    },
    "text-title": {
      "$type": "dimension",
      "$value": "26px"
    },
    "text-manuscript": {
      "$type": "dimension",
      "$value": "17px"
    }
  },
  "components": {},
  "symbols": {
    "NavItem": {
      "props": {
        "label": "string",
        "icon": {
          "enum": [
            "layout-dashboard",
            "pen-line",
            "columns-3",
            "message-square",
            "circle-check",
            "send",
            "scroll-text",
            "folder",
            "audio-lines",
            "settings"
          ]
        }
      },
      "body": [
        {
          "id": "ni-row",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "ni-icon",
              "kind": "icon",
              "name": {
                "$param": "icon"
              },
              "size": 15,
              "fill": "$color-ink-mute"
            },
            {
              "id": "ni-label",
              "kind": "text",
              "text": {
                "$param": "label"
              },
              "fontSize": "$text-caption",
              "fontWeight": 500,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink",
              "width": "fill_container",
              "height": "fit_content"
            }
          ],
          "gap": "$space-2",
          "padding": [
            0,
            "$space-3",
            0,
            "$space-3"
          ],
          "height": 34,
          "alignItems": "center",
          "cornerRadius": "$radius-1"
        }
      ]
    },
    "NavItemActive": {
      "props": {
        "label": "string",
        "icon": {
          "enum": [
            "layout-dashboard",
            "pen-line",
            "columns-3",
            "message-square",
            "circle-check",
            "send",
            "scroll-text",
            "folder",
            "audio-lines",
            "settings"
          ]
        }
      },
      "body": [
        {
          "id": "na-row",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "na-bar",
              "kind": "rect",
              "width": 2,
              "height": 16,
              "fill": "$color-fundamental"
            },
            {
              "id": "na-icon",
              "kind": "icon",
              "name": {
                "$param": "icon"
              },
              "size": 15,
              "fill": "$color-fundamental"
            },
            {
              "id": "na-label",
              "kind": "text",
              "text": {
                "$param": "label"
              },
              "fontSize": "$text-caption",
              "fontWeight": 500,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-fundamental",
              "width": "fill_container",
              "height": "fit_content"
            }
          ],
          "gap": "$space-2",
          "padding": [
            0,
            "$space-3",
            0,
            "$space-3"
          ],
          "height": 34,
          "fill": "$color-fundamental-soft",
          "alignItems": "center",
          "cornerRadius": "$radius-1"
        }
      ]
    },
    "ThreadRow": {
      "props": {
        "num": "string",
        "text": "string",
        "source": "string",
        "state": "string",
        "action": "string"
      },
      "body": [
        {
          "id": "tr-row",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "tr-n",
              "kind": "text",
              "text": {
                "$param": "num"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink-faint",
              "width": 32,
              "height": "fit_content"
            },
            {
              "id": "tr-t",
              "kind": "text",
              "text": {
                "$param": "text"
              },
              "fontSize": "$text-caption",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.65
              },
              "wrap": "width",
              "fill": "$color-ink",
              "width": "fill_container",
              "height": "fit_content"
            },
            {
              "id": "tr-s",
              "kind": "text",
              "text": {
                "$param": "source"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.3
              },
              "wrap": "width",
              "fill": "$color-ink-faint",
              "width": 76,
              "height": "fit_content"
            },
            {
              "id": "tr-st",
              "kind": "text",
              "text": {
                "$param": "state"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.3
              },
              "wrap": "width",
              "fill": "$color-ink-mute",
              "width": 52,
              "height": "fit_content"
            },
            {
              "id": "tr-ac",
              "kind": "text",
              "text": {
                "$param": "action"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.3
              },
              "wrap": "width",
              "fill": "$color-fundamental",
              "width": 44,
              "height": "fit_content",
              "textAlign": "right"
            }
          ],
          "gap": "$space-2",
          "width": "fill_container",
          "height": "fit_content",
          "alignItems": "start"
        }
      ]
    },
    "Chip": {
      "props": {
        "label": "string"
      },
      "body": [
        {
          "id": "ch-box",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "ch-l",
              "kind": "text",
              "text": {
                "$param": "label"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.3
              },
              "wrap": "width",
              "fill": "$color-ink-mute",
              "width": "fit_content",
              "height": "fit_content"
            }
          ],
          "padding": [
            2,
            "$space-2",
            2,
            "$space-2"
          ],
          "width": "fit_content",
          "alignItems": "center",
          "cornerRadius": "$radius-pill",
          "stroke": "$color-line",
          "strokeWidth": 1
        }
      ]
    },
    "StepRow": {
      "props": {
        "label": "string",
        "meta": "string"
      },
      "body": [
        {
          "id": "sr-row",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "sr-icon",
              "kind": "icon",
              "name": "check",
              "size": 13,
              "fill": "$color-fundamental"
            },
            {
              "id": "sr-label",
              "kind": "text",
              "text": {
                "$param": "label"
              },
              "fontSize": "$text-caption",
              "fontWeight": 500,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.4
              },
              "wrap": "width",
              "fill": "$color-ink",
              "width": "fit_content",
              "height": "fit_content"
            },
            {
              "id": "sr-meta",
              "kind": "text",
              "text": {
                "$param": "meta"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.3
              },
              "wrap": "width",
              "fill": "$color-ink-faint",
              "width": "fit_content",
              "height": "fit_content"
            }
          ],
          "gap": "$space-2",
          "width": "fill_container",
          "height": "fit_content",
          "alignItems": "center"
        }
      ]
    },
    "StateChip": {
      "props": {
        "label": "string"
      },
      "body": [
        {
          "id": "sc-box",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "sc-label",
              "kind": "text",
              "text": {
                "$param": "label"
              },
              "fontSize": "$text-micro",
              "fontWeight": 400,
              "fontFamily": "$font-ui",
              "lineHeight": {
                "unit": "multiplier",
                "value": 1.3
              },
              "wrap": "width",
              "fill": "$color-ink-mute",
              "width": "fit_content",
              "height": "fit_content"
            }
          ],
          "padding": [
            2,
            "$space-2",
            2,
            "$space-2"
          ],
          "width": "fit_content",
          "alignItems": "center",
          "cornerRadius": "$radius-pill",
          "stroke": "$color-line",
          "strokeWidth": 1
        }
      ]
    }
  },
  "pages": [
    {
      "id": "p-chat",
      "name": "会话",
      "width": 1440,
      "height": 900,
      "tree": [
        {
          "id": "ct-app",
          "kind": "frame",
          "layout": "horizontal",
          "children": [
            {
              "id": "rl",
              "kind": "frame",
              "layout": "vertical",
              "children": [
                {
                  "id": "rl-brand",
                  "kind": "frame",
                  "layout": "vertical",
                  "children": [
                    {
                      "id": "rl-cn",
                      "kind": "text",
                      "text": "腔调",
                      "fontSize": "$text-section",
                      "fontWeight": 600,
                      "fontFamily": "$font-ui",
                      "lineHeight": {
                        "unit": "multiplier",
                        "value": 1.2
                      },
                      "wrap": "width",
                      "fill": "$color-ink",
                      "width": "fit_content",
                      "height": "fit_content"
                    },
                    {
                      "id": "rl-en",
                      "kind": "text",
                      "text": "Timbre",
                      "fontSize": "$text-micro",
                      "fontWeight": 400,
                      "fontFamily": "$font-ui",
                      "lineHeight": {
                        "unit": "multiplier",
                        "value": 1.4
                      },
                      "wrap": "width",
                      "fill": "$color-ink-mute",
                      "width": "fit_content",
                      "height": "fit_content"
                    }
                  ],
                  "gap": 2
                },
                {
                  "id": "rl-div",
                  "kind": "part",
                  "part": "divider"
                },
                {
                  "id": "rl-nav",
                  "kind": "frame",
                  "layout": "vertical",
                  "children": [
                    {
                      "id": "rl-nav-tones",
                      "kind": "component",
                      "name": "NavItem",
                      "props": {
                        "label": "音色对照",
                        "icon": "columns-3"
                      }
                    },
                    {
                      "id": "rl-n1",
                      "kind": "component",
                      "name": "NavItemActive",
                      "props": {
                        "label": "会话",
                        "icon": "message-square"
                      }
                    },
                    {
                      "id": "rl-n2",
                      "kind": "component",
                      "name": "NavItem",
                      "props": {
                        "label": "审阅",
                        "icon": "circle-check"
                      }
                    },
                    {
                      "id": "rl-n3",
                      "kind": "component",
                      "name": "NavItem",
                      "props": {
                        "label": "设置",
                        "icon": "settings"
                      }
                    }
                  ],
                  "gap": 2
                },
                {
                  "id": "rl-sp",
                  "kind": "frame",
                  "layout": "vertical",
                  "children": [],
                  "width": "fill_container",
                  "height": "fill_container"
                },
                {
                  "id": "rl-acc",
                  "kind": "text",
                  "text": "@yehang_kiosk",
                  "fontSize": "$text-micro",
                  "fontWeight": 400,
                  "fontFamily": "$font-ui",
                  "lineHeight": {
                    "unit": "multiplier",
                    "value": 1.4
                  },
                  "wrap": "width",
                  "fill": "$color-ink-mute",
                  "width": "fit_content",
                  "height": "fit_content"
                }
              ],
              "gap": "$space-4",
              "padding": [
                "$space-4",
                "$space-3",
                "$space-4",
                "$space-3"
              ],
              "width": 240,
              "height": "fill_container",
              "fill": "$color-surface"
            },
            {
              "id": "ct-rule",
              "kind": "rect",
              "width": 1,
              "height": 900,
              "fill": "$color-line"
            },
            {
              "id": "ct-main",
              "kind": "frame",
              "layout": "vertical",
              "children": [
                {
                  "id": "ct-top",
                  "kind": "frame",
                  "layout": "horizontal",
                  "children": [
                    {
                      "id": "ct-top-t",
                      "kind": "frame",
                      "layout": "vertical",
                      "children": [
                        {
                          "id": "ct-title",
                          "kind": "text",
                          "text": "新会话",
                          "fontSize": "$text-display",
                          "fontWeight": 600,
                          "fontFamily": "$font-ui",
                          "lineHeight": {
                            "unit": "multiplier",
                            "value": 1.25
                          },
                          "wrap": "width",
                          "fill": "$color-ink",
                          "width": "fit_content",
                          "height": "fit_content"
                        },
                        {
                          "id": "ct-meta",
                          "kind": "text",
                          "text": "上下文只用本机文件，不连发布接口",
                          "fontSize": "$text-micro",
                          "fontWeight": 400,
                          "fontFamily": "$font-ui",
                          "lineHeight": {
                            "unit": "multiplier",
                            "value": 1.3
                          },
                          "wrap": "width",
                          "fill": "$color-ink-mute",
                          "width": "fit_content",
                          "height": "fit_content"
                        }
                      ],
                      "gap": 2
                    },
                    {
                      "id": "ct-sp",
                      "kind": "frame",
                      "layout": "vertical",
                      "children": [],
                      "width": "fill_container",
                      "height": 12
                    },
                    {
                      "id": "ct-model",
                      "kind": "frame",
                      "layout": "horizontal",
                      "children": [
                        {
                          "id": "ct-model-i",
                          "kind": "icon",
                          "name": "cpu",
                          "size": 13,
                          "fill": "$color-ink-mute"
                        },
                        {
                          "id": "ct-model-t",
                          "kind": "text",
                          "text": "deepseek-chat",
                          "fontSize": "$text-micro",
                          "fontWeight": 400,
                          "fontFamily": "$font-ui",
                          "lineHeight": {
                            "unit": "multiplier",
                            "value": 1.3
                          },
                          "wrap": "width",
                          "fill": "$color-ink-mute",
                          "width": "fit_content",
                          "height": "fit_content"
                        }
                      ],
                      "gap": "$space-1",
                      "padding": [
                        "$space-1",
                        "$space-3",
                        "$space-1",
                        "$space-3"
                      ],
                      "width": "fit_content",
                      "height": 26,
                      "alignItems": "center",
                      "cornerRadius": "$radius-pill",
                      "stroke": "$color-line",
                      "strokeWidth": 1
                    }
                  ],
                  "gap": "$space-3",
                  "width": "fill_container",
                  "height": "fit_content",
                  "alignItems": "center"
                },
                {
                  "id": "ct-cols",
                  "kind": "frame",
                  "layout": "horizontal",
                  "children": [
                    {
                      "id": "ct-flow",
                      "kind": "frame",
                      "layout": "vertical",
                      "children": [
                        {
                          "id": "ct-m1",
                          "kind": "frame",
                          "layout": "horizontal",
                          "children": [
                            {
                              "id": "ct-m1-p",
                              "kind": "part",
                              "part": "bubble",
                              "variant": "user",
                              "label": "我想写一条 X thread：我们店把关门时间挪到凌晨两点之后，看到的东西。重点不是生意变多，是客人变成了什么样的人。"
                            }
                          ],
                          "width": "fill_container",
                          "height": "fit_content",
                          "justifyContent": "end"
                        },
                        {
                          "id": "ct-m2",
                          "kind": "frame",
                          "layout": "vertical",
                          "children": [
                            {
                              "id": "ct-m2-p",
                              "kind": "text",
                              "text": "读了两样东西：母稿和 X 腔调。按「首条下判断、thread 四条封顶」写了四条。",
                              "fontSize": "$text-caption",
                              "fontWeight": 400,
                              "fontFamily": "$font-ui",
                              "lineHeight": {
                                "unit": "multiplier",
                                "value": 1.6
                              },
                              "wrap": "width",
                              "fill": "$color-ink",
                              "width": "fill_container",
                              "height": "fit_content"
                            },
                            {
                              "id": "ct-steps",
                              "kind": "frame",
                              "layout": "vertical",
                              "children": [
                                {
                                  "id": "ct-s1",
                                  "kind": "component",
                                  "name": "StepRow",
                                  "props": {
                                    "label": "读母稿",
                                    "meta": "凌晨一点的骨汤，我蹲了三年，4 段"
                                  }
                                },
                                {
                                  "id": "ct-s2",
                                  "kind": "component",
                                  "name": "StepRow",
                                  "props": {
                                    "label": "读腔调",
                                    "meta": "X v0.4，设计意向"
                                  }
                                },
                                {
                                  "id": "ct-s3",
                                  "kind": "component",
                                  "name": "StepRow",
                                  "props": {
                                    "label": "起草 thread",
                                    "meta": "4 条，512 字"
                                  }
                                }
                              ],
                              "gap": "$space-1",
                              "width": 520
                            },
                            {
                              "id": "ct-card",
                              "kind": "frame",
                              "layout": "vertical",
                              "children": [
                                {
                                  "id": "ct-card-h",
                                  "kind": "frame",
                                  "layout": "horizontal",
                                  "children": [
                                    {
                                      "id": "ct-card-i",
                                      "kind": "icon",
                                      "name": "send",
                                      "size": 14,
                                      "fill": "$color-ink-mute"
                                    },
                                    {
                                      "id": "ct-card-t",
